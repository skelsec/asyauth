# Same lab with an MIT krb5 old enough (1.17) to still have single DES.
FROM debian:buster-slim
RUN printf 'deb http://archive.debian.org/debian buster main\n' > /etc/apt/sources.list \
	&& apt-get -o Acquire::Check-Valid-Until=false update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		krb5-kdc krb5-admin-server krb5-user python3 python3-gssapi \
	&& rm -rf /var/lib/apt/lists/*
COPY krb5.conf /etc/krb5.conf
COPY kdc.conf /etc/krb5kdc/kdc.conf
COPY entrypoint.sh peer.py genvectors.py /
RUN chmod +x /entrypoint.sh
ENV LAB_LEGACY=1
ENTRYPOINT ["/entrypoint.sh"]
